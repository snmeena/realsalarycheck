---
import "../styles/global.css";

const {
  title = "Real Salary Check | Global Tech PPP Calculator",
  description = "Compare job offers globally. Discover your true international purchasing power, local tax burdens, and cost of living metrics before relocating.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

  <!-- Premium Smart SVG Favicon System -->
<!-- This embeds the dynamic vector directly as a data URI, meaning zero network overhead and instant theme sync in the browser tab -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cstyle%3Epath%7Bfill:%2309090b%7D@media(prefers-color-scheme:dark)%7Bpath%7Bfill:%23ffffff%7D%7D%3C/style%3E%3Cpath d='M18 2h-3v3.1c-3.1.4-5.5 2.5-5.5 5.9 0 4.1 3.2 5.5 6 6.5 2.2.8 4 1.5 4 3.5 0 1.6-1.2 2.8-3.5 2.8-2.6 0-4.4-1.4-4.8-3.8h-3c.4 3.9 3.1 6.2 5.8 6.7V30h3v-3.1c3.2-.4 5.7-2.6 5.7-6.1 0-4.6-3.5-5.8-6.3-6.8-2-.7-3.7-1.4-3.7-3.2 0-1.5 1.3-2.5 3.3-2.5 2.2 0 3.8 1.1 4.2 3.2h3c-.4-3.5-2.7-5.7-5.2-6.2V2z'/%3E%3C/svg%3E" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="PPP salary calculator, purchasing power parity, tech relocation index, global cost of living calculator, software engineer salary comparison, cost of living adjustment, international job offer evaluation"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://realsalarycheck.com/" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://realsalarycheck.com/" />
    <meta property="og:site_name" content="RealSalaryCheck" />
    <meta property="og:image" content="https://realsalarycheck.com/og-image.jpg" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://realsalarycheck.com/og-image.jpg" />
    
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f4f5" />

   <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXX" crossorigin="anonymous"></script>

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "RealSalaryCheck",
        "url": "https://realsalarycheck.com/",
        "description": "Advanced multi-tier purchasing power parity and global tax calculation engine evaluating international job values.",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "All"
      }
    </script>

    <slot name="head" />

    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersLight = window.matchMedia(
          "(prefers-color-scheme: light)",
        ).matches;
        if (savedTheme === "light" || (!savedTheme && systemPrefersLight)) {
          document.documentElement.classList.add("light-mode");
        } else {
          document.documentElement.classList.remove("light-mode");
        }
      })();
    </script>
  </head>

  <body class="min-h-screen antialiased flex flex-col relative overflow-x-hidden w-full transition-colors duration-300 selection:bg-emerald-500/30 selection:text-emerald-200">
    <nav
      class="sticky top-0 z-50 border-b backdrop-blur-xl px-4 md:px-6 py-3.5 transition-colors duration-300"
      style="border-color: var(--nav-border); background-color: var(--nav-bg);"
    >
      <div class="max-w-7xl mx-auto flex items-center justify-between relative">
        <a
          href="/"
          class="font-black text-lg md:text-xl tracking-tight transition-colors select-none z-50 flex-shrink-0"
          style="color: var(--logo-primary);"
        >
          Real<span style="color: var(--logo-secondary);">SalaryCheck</span>
        </a>

        <div class="hidden md:flex items-center gap-8">
          <div class="flex items-center gap-6 text-sm font-semibold">
            <a href="/" class="nav-link-premium">Home</a>
            <a href="/about" class="nav-link-premium">About</a>
            <a href="/privacy" class="nav-link-premium">Privacy</a>
            <a href="/terms" class="nav-link-premium">Terms</a>
            <a href="/contact" class="nav-link-premium">Contact</a>
          </div>

          <button
            class="theme-toggle flex items-center justify-center p-2 rounded-xl border transition-all duration-300 hover:bg-white/5 active:scale-95 cursor-pointer"
            style="border-color: var(--input-border);"
            aria-label="Toggle Theme"
          >
            <svg
              class="theme-icon w-5 h-5 transition-transform duration-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              style="color: var(--logo-primary);"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"
              ></path>
            </svg>
          </button>
        </div>

        <div class="flex md:hidden items-center gap-2 z-50">
          <button
            class="theme-toggle flex items-center justify-center p-2 rounded-xl border transition-all duration-300 hover:bg-white/5 active:scale-95 cursor-pointer"
            style="border-color: var(--input-border);"
            aria-label="Toggle Theme"
          >
            <svg
              class="theme-icon w-5 h-5 transition-transform duration-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              style="color: var(--logo-primary);"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"
              ></path>
            </svg>
          </button>

          <button
            id="hamburgerBtn"
            class="p-2 flex flex-col justify-center items-center gap-1.5 focus:outline-none cursor-pointer"
            aria-label="Open Menu"
          >
            <span
              class="hamburger-line w-5 h-0.5 rounded-full transition-all duration-300"
              style="background-color: var(--logo-primary);"></span>
            <span
              class="hamburger-line w-5 h-0.5 rounded-full transition-all duration-300"
              style="background-color: var(--logo-primary);"></span>
            <span
              class="hamburger-line w-5 h-0.5 rounded-full transition-all duration-300"
              style="background-color: var(--logo-primary);"></span>
          </button>
        </div>
      </div>

      <div
        id="mobileMenu"
        class="absolute top-full left-0 w-full opacity-0 invisible -translate-y-4 shadow-2xl transition-all duration-300 ease-out"
        style="background-color: var(--nav-bg); border-bottom: 1px solid var(--nav-border);"
      >
        <div class="px-6 py-6 flex flex-col gap-5">
          <a
            href="/"
            class="text-base font-bold tracking-wide transition-colors"
            style="color: var(--logo-primary);">Home</a
          >
          <a
            href="/about"
            class="text-base font-bold tracking-wide transition-colors"
            style="color: var(--logo-primary);">About</a
          >
          <a
            href="/privacy"
            class="text-base font-bold tracking-wide transition-colors"
            style="color: var(--logo-primary);">Privacy Policy</a
          >
          <a
            href="/terms"
            class="text-base font-bold tracking-wide transition-colors"
            style="color: var(--logo-primary);">Terms of Service</a
          >
          <a
            href="/contact"
            class="text-base font-bold tracking-wide transition-colors"
            style="color: var(--logo-primary);">Contact</a
          >
        </div>
      </div>
    </nav>

    <div class="flex-grow w-full relative">
      <slot />
    </div>

    <footer
      class="border-t py-12 px-4 md:px-6 transition-colors duration-300"
      style="border-color: var(--footer-border); background-color: transparent;"
    >
      <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left"
      >
        <div class="space-y-3 max-w-sm">
          <a
            href="/"
            class="font-black text-lg tracking-tight select-none"
            style="color: var(--logo-primary);"
          >
            Real<span style="color: var(--logo-secondary);">SalaryCheck</span>
          </a>
          <p
            class="text-sm font-medium leading-relaxed"
            style="color: var(--nav-text);"
          >
            Compare job offers globally. Discover your true international
            purchasing power after local taxes and cost of living.
          </p>
        </div>
        <div class="flex flex-col items-center md:items-end gap-5">
          <div
            class="flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-sm font-semibold"
          >
            <a href="/about" class="nav-link-premium">About</a>
            <a href="/privacy" class="nav-link-premium">Privacy</a>
            <a href="/terms" class="nav-link-premium">Terms</a>
            <a href="/contact" class="nav-link-premium">Contact</a>
          </div>
          <p
            class="text-xs font-medium tracking-wide"
            style="color: var(--logo-secondary);"
          >
            &copy; {new Date().getFullYear()} RealSalaryCheck. All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const html = document.documentElement;
      const themeToggles = document.querySelectorAll(".theme-toggle");
      const themeIcons = document.querySelectorAll(".theme-icon path");

      const sunPath =
        "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707";
      const moonPath = "M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z";

      function updateThemeIcons() {
        const isLight = html.classList.contains("light-mode");
        themeIcons.forEach((icon) => {
          icon.setAttribute("d", isLight ? moonPath : sunPath);
        });
      }
      updateThemeIcons();

      themeToggles.forEach((toggle) => {
        toggle.addEventListener("click", () => {
          html.classList.toggle("light-mode");
          localStorage.setItem(
            "theme",
            html.classList.contains("light-mode") ? "light" : "dark",
          );
          updateThemeIcons();
        });
      });

      const hamburgerBtn = document.getElementById("hamburgerBtn");
      const mobileMenu = document.getElementById("mobileMenu");
      const hamburgerLines = document.querySelectorAll(".hamburger-line");

      hamburgerBtn?.addEventListener("click", () => {
        const isMenuHidden = mobileMenu?.classList.contains("invisible");
        if (isMenuHidden) {
          mobileMenu?.classList.remove(
            "invisible",
            "opacity-0",
            "-translate-y-4",
          );
          mobileMenu?.classList.add("opacity-100", "translate-y-0");
          if (hamburgerLines.length === 3) {
            (hamburgerLines[0] as HTMLElement).style.transform =
              "translateY(8px) rotate(45deg)";
            (hamburgerLines[1] as HTMLElement).style.opacity = "0";
            (hamburgerLines[2] as HTMLElement).style.transform =
              "translateY(-8px) rotate(-45deg)";
          }
        } else {
          mobileMenu?.classList.add("invisible", "opacity-0", "-translate-y-4");
          mobileMenu?.classList.remove("opacity-100", "translate-y-0");
          hamburgerLines.forEach((line) => {
            (line as HTMLElement).style.transform = "none";
            (line as HTMLElement).style.opacity = "1";
          });
        }
      });
    </script>
  </body>
</html>
