---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <slot name="head">
    <meta name="robots" content="noindex, follow" />
  </slot>

  <main class="min-h-[70vh] flex flex-col items-center justify-center px-6 text-center" style="gap: 1.5rem;">
    
    <h1 class="font-black tracking-tighter leading-none bg-gradient-to-b from-white via-zinc-300 to-zinc-600 bg-clip-text text-transparent light-mode:from-zinc-900 light-mode:to-zinc-500 select-none"
        style="font-size: clamp(8rem, 25vw, 16rem); margin: 0;">
      404
    </h1>

    <a href="/" 
       class="group transition-all duration-200 cursor-pointer active:scale-[0.98] shadow-xl shadow-black/20 hover:bg-white"
       style="display: inline-flex; align-items: center; justify-content: center; gap: 0.75rem; background-color: #f4f4f5; color: #09090b; padding: 1rem 2rem; border-radius: 0.75rem; font-weight: 700; font-size: 0.875rem; letter-spacing: 0.05em; text-transform: uppercase; white-space: nowrap; width: max-content; margin: 0 auto; text-decoration: none;">
      
      <svg xmlns="http://www.w3.org/2000/svg" 
           class="transform transition-transform duration-200 group-hover:-translate-x-1" 
           style="height: 1.25rem; width: 1.25rem; flex-shrink: 0;"
           fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Go to Homepage
    </a>

  </main>
</Layout>