---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms | RealSalaryCheck">
  <main class="max-w-2xl mx-auto px-4 py-16 md:py-24 animate-fade-in">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4" style="color: var(--logo-primary)">Terms of Service</h1>
      <p class="text-sm font-medium leading-relaxed" style="color: var(--nav-text)">Operational Framework Agreements</p>
    </div>

    <div class="rounded-2xl p-6 md:p-8 space-y-8 shadow-xl" style="background-color: var(--card-bg); border: 1px solid var(--card-border);">
      <section class="space-y-3">
        <h2 class="text-lg font-bold" style="color: var(--logo-primary)">1. Intended Use</h2>
        <p class="text-sm leading-relaxed" style="color: var(--nav-text)">
          Users are authorized to utilize our conversion calculators purely for personal research and comparative planning. Scraped extraction of data or programmatic flooding of our servers is strictly prohibited.
        </p>
      </section>
      <section class="space-y-3">
        <h2 class="text-lg font-bold" style="color: var(--logo-primary)">2. Financial Disclaimer</h2>
        <p class="text-sm leading-relaxed" style="color: var(--nav-text)">
          Our estimates do not constitute official financial, tax, or legal consulting. Never sign final employment contracts relying exclusively on programmatic estimates.
        </p>
      </section>
      <section class="space-y-3">
        <h2 class="text-lg font-bold" style="color: var(--logo-primary)">3. Liability Limits</h2>
        <p class="text-sm leading-relaxed" style="color: var(--nav-text)">
          This software is delivered "as-is." We offer no warranties regarding absolute accuracy or uptime and are not liable for any financial outcomes derived from this platform.
        </p>
      </section>
    </div>
  </main>
</Layout>